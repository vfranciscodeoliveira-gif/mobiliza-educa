rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformOwners/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformOwners/$(request.auth.uid)).data.active == true;
    }

    function member(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.active == true;
    }

    function manager(tenantId) {
      return member(tenantId)
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'GESTOR';
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /publicTenants/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /platformOwners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || platformOwner());
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || platformOwner());
      allow write: if false;
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || platformOwner());
      allow write: if false;
    }

    match /subscriptions/{tenantId} {
      allow read: if member(tenantId) || platformOwner();
      allow write: if false;
    }

    match /tenants/{tenantId} {
      allow read: if member(tenantId) || platformOwner();
      allow write: if false;

      match /members/{uid} {
        allow read: if signedIn()
          && (request.auth.uid == uid || manager(tenantId) || platformOwner());
        allow write: if false;
      }

      match /{collection}/{docId} {
        function educationCollection() {
          return collection in ['schools', 'classes', 'students', 'institutions', 'contacts', 'teachers'];
        }
        function educationWriter() {
          return platformOwner() || (member(tenantId)
            && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role in ['GESTOR', 'OPERADOR']);
        }
        allow read: if educationCollection() && (member(tenantId) || platformOwner());
        allow create: if educationCollection() && educationWriter()
          && request.resource.data.tenantId == tenantId
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0
          && request.resource.data.nome.size() <= 250
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if educationCollection() && educationWriter()
          && request.resource.data.tenantId == tenantId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0
          && request.resource.data.nome.size() <= 250
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }

      match /requests/{docId} {
        allow read: if member(tenantId) || platformOwner();
        allow write: if false;
      }

      match /registrations/{docId} {
        allow read: if member(tenantId) || platformOwner();
        allow write: if false;
      }



      match /publicEvents/{docId} {
        allow read: if member(tenantId) || platformOwner();
        allow write: if false;
      }

      match /certificates/{docId} {
        allow read: if member(tenantId) || platformOwner();
        allow write: if false;
      }

      match /auditLogs/{docId} {
        allow read: if manager(tenantId) || platformOwner();
        allow write: if false;
      }

      match /pushDevices/{docId} {
        allow read: if false;
        allow write: if false;
      }

      match /{document=**} {
        allow read: if member(tenantId) || platformOwner();
        allow write: if false;
      }
    }

    match /platform/{docId} {
      allow read: if platformOwner();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
