rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function member(tenantId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.active == true;
    }

    match /public-invites/lorena-15/{fileName} {
      allow read: if firestore.exists(/databases/(default)/documents/publicInvites/lorena-15)
        && firestore.get(/databases/(default)/documents/publicInvites/lorena-15).data.publicado == true;
      allow write: if signedIn()
        && firestore.exists(/databases/(default)/documents/platformOwners/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/platformOwners/$(request.auth.uid)).data.active == true
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)')));
    }
    match /tenants/{tenantId}/evidence/{allPaths=**} {
      allow read: if member(tenantId);
      allow write: if member(tenantId)
        && request.resource.size < 12 * 1024 * 1024;
    }

    match /tenants/{tenantId}/documents/{allPaths=**} {
      allow read: if member(tenantId);
      allow write: if member(tenantId)
        && request.resource.size < 20 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
