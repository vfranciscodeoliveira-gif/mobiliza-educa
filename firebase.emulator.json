{
  "functions":[
    {
      "source":"firebase/functions",
      "codebase":"default",
      "ignore":["node_modules",".git","firebase-debug.log"]
    }
  ],
  "firestore":{
    "rules":"firestore.rules",
    "indexes":"firestore.indexes.json"
  },
  "hosting":{
    "public":".",
    "ignore":[
      "firebase.json",
      "firebase.emulator.json",
      "**/.*",
      "**/node_modules/**",
      "firebase/**",
      "*.rules",
      "firestore.indexes.json"
    ]
  },
  "emulators":{
    "auth":{"port":9099},
    "functions":{"port":5001},
    "firestore":{"port":8080},
    "hosting":{"port":5000},
    "ui":{"enabled":true,"port":4000},
    "singleProjectMode":true
  }
}
